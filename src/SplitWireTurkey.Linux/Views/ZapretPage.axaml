<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SplitWireTurkey.Linux.Views.ZapretPage">
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock x:Name="Header" FontSize="20" FontWeight="Bold" Text="zapret (tpws) — Linux native" />
      <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Opacity="0.8"
                 Text="Runs bol-van/zapret's tpws as a systemd service with a preset strategy. zapret originates on Linux, so full blockcheck functionality is available." />

      <TextBlock x:Name="PresetLabel" FontWeight="Bold" Text="Preset:" />
      <ComboBox x:Name="PresetCombo" MinWidth="420" SelectionChanged="PresetSelectionChanged" />
      <TextBlock x:Name="ArgsLabel" FontWeight="Bold" Text="tpws arguments (editable):" />
      <TextBox x:Name="ArgsBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" />
      <CheckBox x:Name="PersistBox" Content="Persist after reboot (systemd enable --now)" IsChecked="True" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="Install" Click="OnInstallClicked" Content="Install preset service" />
        <Button x:Name="Remove" Click="OnRemoveClicked" Content="Remove zapret" />
        <Button x:Name="BlockCheck" Click="OnBlockCheckClicked" Content="Run blockcheck" />
      </StackPanel>
      <TextBlock x:Name="Status" FontSize="13" Opacity="0.9" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
