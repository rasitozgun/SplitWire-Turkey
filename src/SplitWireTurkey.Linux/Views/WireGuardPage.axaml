<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SplitWireTurkey.Linux.Views.WireGuardPage">
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock x:Name="Header" FontSize="20" FontWeight="Bold" Text="Cloudflare WARP (wgcf) Tunnel" />
      <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Opacity="0.8"
                 Text="Registers a Cloudflare WARP account with wgcf and brings up the tunnel with wg-quick as a systemd service. The WireSock split-tunnel client has no Linux edition." />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="Register" Click="OnRegisterClicked" Content="Register / Create profile" />
        <Button x:Name="Install" Click="OnInstallClicked" Content="Install tunnel service" />
        <Button x:Name="Remove" Click="OnRemoveClicked" Content="Remove tunnel" />
      </StackPanel>
      <TextBlock x:Name="Status" FontSize="13" Opacity="0.9" />
      <TextBox x:Name="Profile" IsReadOnly="True" AcceptsReturn="True" Height="140" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
