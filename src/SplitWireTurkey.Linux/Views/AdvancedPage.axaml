<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SplitWireTurkey.Linux.Views.AdvancedPage">
  <ScrollViewer>
    <StackPanel Margin="8" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock x:Name="Header" FontSize="20" FontWeight="Bold" Text="Advanced" />

      <TextBlock x:Name="ServicesHeader" FontWeight="Bold" Text="Installed services:" />
      <TextBox x:Name="ServicesList" IsReadOnly="True" AcceptsReturn="True" Height="110" />

      <TextBlock x:Name="DnsHeader" FontWeight="Bold" Text="DNS (NetworkManager):" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox x:Name="PrimaryBox" Width="220" Watermark="Primary (default: Google)" />
        <TextBox x:Name="SecondaryBox" Width="220" Watermark="Secondary (default: Quad9)" />
        <Button x:Name="ApplyDns" Click="OnApplyDnsClicked" Content="Apply DNS" />
        <Button x:Name="ResetDnsButton" Click="OnResetDnsClicked" Content="Reset (DHCP)" />
      </StackPanel>

      <Button x:Name="RemoveAll" Click="OnRemoveAllClicked" Content="Remove all SplitWire services" />
      <TextBlock x:Name="Status" FontSize="13" Opacity="0.9" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
