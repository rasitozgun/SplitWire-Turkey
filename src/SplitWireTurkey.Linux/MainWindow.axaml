<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SplitWireTurkey.Linux.Views"
        x:Class="SplitWireTurkey.Linux.MainWindow"
        Title="SplitWire-Turkey (Linux)"
        Width="900" Height="640"
        MinWidth="760" MinHeight="520"
        Background="{DynamicResource SwBackgroundColor}">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource SwTextColor}" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource SwAccentColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource SwErrorColor}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Header -->
    <Grid DockPanel.Dock="Top" Margin="16,14,16,10" ColumnDefinitions="Auto,*,Auto">
      <TextBlock Classes="h1" Text="SplitWire-Turkey" />
      <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0,0,4"
                 Foreground="{DynamicResource SwTextColor}" Opacity="0.7"
                 Text="Linux Edition (under development)" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button x:Name="LangTrButton" Content="TR" Click="OnLanguageClicked" />
        <Button x:Name="LangEnButton" Content="EN" Click="OnLanguageClicked" />
        <Button x:Name="LangRuButton" Content="RU" Click="OnLanguageClicked" />
        <Button x:Name="LangEsButton" Content="ES" Click="OnLanguageClicked" />
      </StackPanel>
    </Grid>

    <!-- Content -->
    <Grid RowDefinitions="*,160" Margin="16,0,16,16">
      <TabControl x:Name="MainTabs" Background="Transparent">
        <TabItem Header="WireGuard" x:Name="TabWG">
          <views:WireGuardPage />
        </TabItem>
        <TabItem Header="ByeDPI" x:Name="TabByeDpi">
          <views:ByeDpiPage />
        </TabItem>
        <TabItem Header="Zapret" x:Name="TabZapret">
          <views:ZapretPage />
        </TabItem>
        <TabItem Header="Advanced" x:Name="TabAdvanced">
          <views:AdvancedPage />
        </TabItem>
      </TabControl>

      <!-- Log pane -->
      <ScrollViewer Grid.Row="1" Classes="logPane" Margin="0,12,0,0"
                    Background="{DynamicResource SwCardBackground}" CornerRadius="8">
        <TextBox x:Name="LogTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                 IsReadOnly="True" Height="150" FontFamily="DejaVu Sans Mono" FontSize="12" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
